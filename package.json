{
  "name": "playablefactory-rag-case",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic search and grounded RAG over an internal document corpus.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && npm run typecheck --workspace=@corpus/web",
    "typecheck:clean": "tsc --build --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "tsc --build && npm run build --workspace=@corpus/web",
    "dev": "node scripts/dev.mjs",
    "seed": "npm run seed --workspace=@corpus/api",
    "ingest": "npm run ingest --workspace=@corpus/api",
    "eval": "npm run eval --workspace=@corpus/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
