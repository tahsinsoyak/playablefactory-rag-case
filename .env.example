# Copy to .env and fill in. `.env` is gitignored; never commit real values.
# Only the LLM API key has no working default: everything else runs as-is.

# --- answer generation -------------------------------------------------------
# The one hosted service this project needs. Only answer generation uses it -
# search, ingestion, the dashboard, and the MCP server all work without a key.
#
# The chat model sits behind a `ChatModel` port, so the provider is a config
# choice. OpenRouter is the only provider: one key already reaches every model
# family, so a second adapter would add a code path without adding reach.

# One key reaches every model. Get one at https://openrouter.ai/keys - they
# start with "sk-or-". Browse model ids at https://openrouter.ai/models.
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.7-flash
OPENROUTER_API_KEY=sk-or-...

# The model that scores answers in `npm run eval:answers -- --judge`. It must
# differ from LLM_MODEL: a model grading its own output rates it generously, and
# the eval refuses to run if the two match. Any OpenRouter model works; a
# stricter judge is more useful than a generous one, because a judge that never
# deducts cannot detect a regression.
#   openai/gpt-5-mini           $0.25 / $2.00 per 1M    the default
#   openai/gpt-4o-mini          $0.15 / $0.60           cheaper, deducted nothing
#   google/gemini-2.5-pro       $1.25 / $10.00
JUDGE_MODEL=openai/gpt-5-mini

# The default is chosen for cost: qwen3.7-flash is $0.03 per 1M input tokens
# and $0.13 per 1M output, and answers all five sample questions correctly
# while refusing all three out-of-corpus probes. Grounded extraction over a few
# short passages does not need a frontier model - retrieval does the hard part.
#
# Other ids that work unchanged - swapping one is the whole change:
#   LLM_MODEL=openai/gpt-5-nano            $0.05 / $0.40
#   LLM_MODEL=openai/gpt-5-mini            $0.25 / $2.00
#   LLM_MODEL=deepseek/deepseek-chat       $0.26 / $1.03
#   LLM_MODEL=google/gemini-2.5-flash      $0.30 / $2.50


# --- embeddings --------------------------------------------------------------
# Runs locally via transformers.js: no API key, no network after the first run.
# Changing this invalidates the index and forces a full re-ingest, because the
# vector width and the vector space both change.
EMBEDDER=local:bge-small-en-v1.5
# Cross-encoder reranking, applied to answering and not to plain search. Costs
# about a second per query and lifts sample MRR from 0.717 to 0.815. `none`
# turns it off. Downloads ~23 MB on first use, then cached.
RERANKER=local:ms-marco-MiniLM-L-6-v2
# Where the ~35 MB model is cached on first run. Gitignored.
MODEL_CACHE_DIR=./.models

# --- storage -----------------------------------------------------------------
DATABASE_PATH=./data/corpus.db
CORPUS_DIR=./corpus

# --- auth --------------------------------------------------------------------
# Generate your own: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Passwords for the two demo accounts created by `npm run seed`.
SEED_USER_EMAIL=user@demo.local
SEED_USER_PASSWORD=demo-user-pw
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=demo-admin-pw

# --- servers -----------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# The login page offers one-click sign-in for the accounts below. The API serves
# them from GET /auth/demo-accounts and returns nothing when NODE_ENV=production,
# so no build of the web app ever contains a password.

# --- MCP ---------------------------------------------------------------------
# Static bearer token the MCP server requires from clients. See README for how
# OIDC would replace this.
MCP_AUTH_TOKEN=change-me-mcp

# --- OIDC provider, for the MCP server's HTTP transport (bonus) --------------
# The API issues RS256 access tokens and publishes discovery and JWKS. The MCP
# HTTP transport verifies against them; it holds no key material of its own.
OIDC_ISSUER=http://localhost:4000
# RFC 8707 resource indicator: tokens are minted for this audience only, so one
# that leaks cannot be replayed against the main API.
MCP_RESOURCE=http://localhost:4100/mcp
MCP_HTTP_PORT=4100
OIDC_TOKEN_TTL_SECONDS=3600
# The OAuth client `npm run seed` registers. Leave the secret unset and the
# client is skipped: a default credential is worse than no credential.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_CLIENT_ID=corpus-mcp
MCP_CLIENT_SECRET=
