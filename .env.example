# Copy to .env and fill in. `.env` is gitignored; never commit real values.
# Only the LLM API key has no working default — everything else runs as-is.

# --- answer generation -------------------------------------------------------
# The one hosted service this project needs. Only answer generation uses it -
# search, ingestion, the dashboard, and the MCP server all work without a key.
#
# The chat model sits behind a `ChatModel` port, so the provider is a config
# choice. Two adapters ship: `openrouter` (default) and `anthropic`.

# --- option 1: OpenRouter (default) ---
# One key reaches every model. Get one at https://openrouter.ai/keys - they
# start with "sk-or-". Browse model ids at https://openrouter.ai/models.
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-opus-5
OPENROUTER_API_KEY=sk-or-...

# Other model ids that work unchanged - swapping one is the whole change:
#   LLM_MODEL=anthropic/claude-sonnet-5
#   LLM_MODEL=openai/gpt-4o
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=deepseek/deepseek-chat

# --- option 2: Anthropic directly ---
# Uncomment these two and comment out the OpenRouter block above.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- embeddings --------------------------------------------------------------
# Runs locally via transformers.js: no API key, no network after the first run.
# Changing this invalidates the index and forces a full re-ingest, because the
# vector width and the vector space both change.
EMBEDDER=local:bge-small-en-v1.5
# Where the ~35 MB model is cached on first run. Gitignored.
MODEL_CACHE_DIR=./.models

# --- storage -----------------------------------------------------------------
DATABASE_PATH=./data/corpus.db
CORPUS_DIR=./corpus

# --- auth --------------------------------------------------------------------
# Generate your own: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Passwords for the two demo accounts created by `npm run seed`.
SEED_USER_EMAIL=user@demo.local
SEED_USER_PASSWORD=demo-user-pw
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=demo-admin-pw

# --- servers -----------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- MCP ---------------------------------------------------------------------
# Static bearer token the MCP server requires from clients. See README for how
# OIDC would replace this.
MCP_AUTH_TOKEN=change-me-mcp
