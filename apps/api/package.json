{
  "name": "@corpus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP API: auth, search, grounded answers, corpus management, analytics.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ingest": "tsx src/scripts/ingest.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "@corpus/rag": "*",
    "@corpus/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10"
  }
}
